# copy to .env and fill in — .env never goes to GitHub
# LINE (LINE Developers console)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LIFF_CHANNEL_ID=
# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Roboflow (only needed once the packaging model is trained)
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://detect.roboflow.com
# a long random string that signs the login cookie (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
SESSION_SECRET=
# APP_ENV=dev + DEV_USER_ID=U-dev lets you try the app on the PC without LINE (never on Railway)
APP_ENV=
DEV_USER_ID=
